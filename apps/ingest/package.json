{
  "name": "@posvoji/ingest",
  "version": "0.1.0",
  "description": "Batch pipeline: crawl enabled providers, normalize, export the static dataset",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate": "tsx src/validate-policies.ts",
    "export": "tsx src/export.ts",
    "fetch:logos": "tsx src/fetch-logos.ts",
    "derive:images": "tsx src/derive-images.ts",
    "fetch:model": "tsx src/fetch-model.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@posvoji/provider-horjul": "workspace:*",
    "@posvoji/provider-ljubljana": "workspace:*",
    "@posvoji/provider-macja-hisa": "workspace:*",
    "@posvoji/provider-macji-dol": "workspace:*",
    "@posvoji/provider-mala-hisa": "workspace:*",
    "@posvoji/provider-maribor": "workspace:*",
    "@posvoji/provider-meli": "workspace:*",
    "@posvoji/provider-muri": "workspace:*",
    "@posvoji/provider-obalno": "workspace:*",
    "@posvoji/provider-sdk": "workspace:*",
    "@posvoji/provider-turk": "workspace:*",
    "@posvoji/provider-zonzani": "workspace:*",
    "@posvoji/schema": "workspace:*",
    "onnxruntime-node": "1.30.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "fast-check": "^4.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
