# Copy to .env and load it into the environment before running the portal.
# The defaults in portal/settings.py already cover local development, so an
# empty file works there. README.md explains every variable.

# Blank generates a new development-only key each time the process starts.
PORTAL_SECRET_KEY=
PORTAL_DEBUG=true
PORTAL_ALLOWED_HOSTS=localhost,127.0.0.1
PORTAL_DB_PATH=
# Seconds a writer waits for the SQLite lock, and the statements run on every
# new connection. Blank means 20 and
# "PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL;".
PORTAL_DB_TIMEOUT=
PORTAL_DB_INIT_COMMAND=

# Development only. Off unless set here, and forced off whenever PORTAL_DEBUG
# is false. Enables GET /api/auth/dev/shelters and
# POST /api/auth/dev/login, which open a session as any shelter with no mail.
PORTAL_DEV_LOGIN=true

# Frontend and CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Limit login-link mail by client IP. Blank trusts one X-Forwarded-For hop only
# from a loopback peer; set the number of trusted rightmost hops for any other
# proxy topology, or 0 to always use REMOTE_ADDR.
PORTAL_LOGIN_LINK_RATE=5/hour
PORTAL_TRUSTED_PROXY_COUNT=

# And by recipient, so nobody can make the portal fill one shelter's inbox by
# changing network. Same n/period format.
PORTAL_LOGIN_LINK_ADDRESS_RATE=3/hour

# Both counters live here. A file cache is shared between worker processes,
# which a local-memory one is not. Blank uses apps/portal/cache.
PORTAL_CACHE_DIR=

# Read only inputs from the repository. DATASET_PATH is the merged dataset the
# site reads and the listing shows; CRAWLED_DATASET_PATH is the same run's
# records before any override was merged, which baselines and the admin's
# crawl state compare against. Blank means data/dist/animals.json and
# data/dist/animals.crawled.json.
DATASET_PATH=
CRAWLED_DATASET_PATH=
SHELTERS_YAML=
PROVIDERS_DIR=

# Photographs uploaded with manual listings. Django serves them itself while
# PORTAL_DEBUG is on; a deployment serves PORTAL_MEDIA_ROOT from nginx.
# PORTAL_PUBLIC_URL is where this service answers from and is prefixed onto
# every photo URL in GET /api/export/listings.
PORTAL_MEDIA_ROOT=
PORTAL_PUBLIC_URL=http://localhost:8000

# Bearer token the ingest pipeline uses for GET /api/export.
# Unset means the endpoint answers 503.
PORTAL_EXPORT_TOKEN=

# Mail. In development the console backend prints the login link.
# TLS is STARTTLS on 587, SSL is implicit TLS on 465. Never both.
PORTAL_EMAIL_BACKEND=
PORTAL_EMAIL_HOST=localhost
PORTAL_EMAIL_PORT=25
PORTAL_EMAIL_USER=
PORTAL_EMAIL_PASSWORD=
PORTAL_EMAIL_USE_TLS=false
PORTAL_EMAIL_USE_SSL=false
# Seconds per socket operation of a send, not per send. A host that stalls
# at every step holds a worker for several multiples of this.
PORTAL_EMAIL_TIMEOUT=10
# The From address is send-only; PORTAL_REPLY_TO_EMAIL is the one a person
# reads, and the mail prints it as the address for questions.
PORTAL_FROM_EMAIL=portal@posvoji.si
PORTAL_FROM_NAME=Posvoji.si
PORTAL_REPLY_TO_EMAIL=info@posvoji.si
