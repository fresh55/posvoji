# Copy to .env and load it into the environment before running the portal.
# The defaults in portal/settings.py already cover local development, so an
# empty file works there. README.md explains every variable.

# Blank generates a new development-only key each time the process starts.
PORTAL_SECRET_KEY=
PORTAL_DEBUG=true
PORTAL_ALLOWED_HOSTS=localhost,127.0.0.1
PORTAL_DB_PATH=

# Development only. Off unless set here, and forced off whenever PORTAL_DEBUG
# is false. Enables GET /api/auth/dev/shelters and
# POST /api/auth/dev/login, which open a session as any shelter with no mail.
PORTAL_DEV_LOGIN=true

# Frontend and CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Limit login-link mail by client IP. Blank trusts one X-Forwarded-For hop only
# from a loopback peer; set the number of trusted rightmost hops for any other
# proxy topology, or 0 to always use REMOTE_ADDR.
PORTAL_LOGIN_LINK_RATE=5/hour
PORTAL_TRUSTED_PROXY_COUNT=

# Read only inputs from the repository
DATASET_PATH=
SHELTERS_YAML=
PROVIDERS_DIR=

# Photographs uploaded with manual listings. Django serves them itself while
# PORTAL_DEBUG is on; a deployment serves PORTAL_MEDIA_ROOT from nginx.
# PORTAL_PUBLIC_URL is where this service answers from and is prefixed onto
# every photo URL in GET /api/export/listings.
PORTAL_MEDIA_ROOT=
PORTAL_PUBLIC_URL=http://localhost:8000

# Bearer token the ingest pipeline uses for GET /api/export.
# Unset means the endpoint answers 503.
PORTAL_EXPORT_TOKEN=

# Mail. In development the console backend prints the login link.
PORTAL_EMAIL_BACKEND=
PORTAL_EMAIL_HOST=localhost
PORTAL_EMAIL_PORT=25
PORTAL_EMAIL_USER=
PORTAL_EMAIL_PASSWORD=
PORTAL_EMAIL_USE_TLS=false
PORTAL_FROM_EMAIL=portal@posvoji.si
