# Copy to /srv/posvoji/portal.env on the host, owned posvoji:posvoji, mode
# 600, and fill in every blank. Unlike .env.example, none of these have a
# usable default: the development defaults in portal/settings.py are wrong
# here, and several of them are wrong in a way that only shows up in
# production. docs/DEPLOY-PORTAL.md is the order to do this in.

# Generate, never copy:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
PORTAL_SECRET_KEY=

# False, and not just because of the debug pages: it is what forces the dev
# login off. Leave PORTAL_DEV_LOGIN false as well, so the file does not read
# as if the shortcut were available here.
PORTAL_DEBUG=false
PORTAL_DEV_LOGIN=false

PORTAL_ALLOWED_HOSTS=api.posvoji.si

# Caddy terminates TLS and proxies on loopback, so without this Django sees a
# plain http request and drops the strict referer check CSRF applies to https.
# Only ever true when a proxy sets X-Forwarded-Proto on every request.
PORTAL_TRUST_PROXY_PROTO=true

# The site the portal UI is served from. Same registrable domain as the API,
# which is what lets the SameSite=Lax session cookie travel at all, and what
# the login link is built from.
FRONTEND_URL=https://posvoji.si
CORS_ORIGINS=https://posvoji.si

# Outside the release tree: the database outlives every deploy.
PORTAL_DB_PATH=/srv/posvoji/portal-data/db.sqlite3

# Caddy is on loopback and adds one X-Forwarded-For hop, which the portal
# trusts by default. Set a number here only if that stops being true.
PORTAL_LOGIN_LINK_RATE=5/hour
PORTAL_TRUSTED_PROXY_COUNT=

# Uploaded photographs. Served by Caddy from the same path, so the directory
# is group-readable by caddy. PORTAL_PUBLIC_URL is prefixed onto every photo
# URL in GET /api/export/listings, so ingest must be able to fetch it.
PORTAL_MEDIA_ROOT=/srv/posvoji/portal-media
PORTAL_PUBLIC_URL=https://api.posvoji.si

# The bearer token ingest sends to /api/export and /api/export/listings. The
# same value has to be set in the crawl clone's environment; a mismatch is a
# 401, which carries every shelter forward and exits 2.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
PORTAL_EXPORT_TOKEN=

# The login is a mailed link, so a portal that cannot send mail cannot let
# anyone in. The console backend used in development drops the link silently.
PORTAL_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
PORTAL_EMAIL_HOST=
PORTAL_EMAIL_PORT=587
PORTAL_EMAIL_USER=
PORTAL_EMAIL_PASSWORD=
PORTAL_EMAIL_USE_TLS=true
PORTAL_FROM_EMAIL=portal@posvoji.si
