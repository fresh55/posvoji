{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node scripts/generate-animal-descriptions.mjs && tsx scripts/generate-picker-data.ts && tsx scripts/generate-client-payloads.ts && next dev",
    "build": "node scripts/generate-animal-descriptions.mjs && tsx scripts/generate-picker-data.ts && tsx scripts/generate-client-payloads.ts && pnpm generate:srecko-share && next build && node scripts/drop-dev-output.mjs && node scripts/precompress-out.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "test:e2e:cat": "playwright test --config=playwright.cat.config.ts",
    "generate:postal-districts": "node scripts/generate-postal-districts.mjs",
    "generate:font-subset": "node scripts/generate-font-subset.mjs",
    "generate:postcode-municipalities": "node scripts/generate-postcode-municipalities.mjs",
    "generate:animal-descriptions": "node scripts/generate-animal-descriptions.mjs",
    "generate:srecko-share": "tsx scripts/draw-srecko-share.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@posvoji/schema": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "motion": "13.4.0",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "three": "0.186.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3",
    "vaul": "^1.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.5",
    "jsdom": "^26.1.0",
    "meshoptimizer": "1.2.0",
    "proj4": "^2.22.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
