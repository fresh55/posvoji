{
  "name": "posvoji",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "validate:policies": "pnpm --filter @posvoji/ingest validate",
    "dataset:export": "pnpm --filter @posvoji/ingest export"
  }
}
