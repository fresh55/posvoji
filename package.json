{
  "name": "posvoji",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm validate:policies && pnpm --filter web build",
    "test": "pnpm test:node && pnpm test:portal",
    "test:node": "pnpm -r test",
    "test:portal": "uv run --directory apps/portal pytest",
    "test:visual": "pnpm --filter web test:e2e:visual",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm lint:node && pnpm lint:portal",
    "lint:node": "pnpm -r lint",
    "lint:portal": "uv run --directory apps/portal ruff check . && uv run --directory apps/portal ruff format --check .",
    "validate:policies": "pnpm --filter @posvoji/ingest validate",
    "dataset:export": "pnpm --filter @posvoji/ingest export",
    "logos:fetch": "pnpm --filter @posvoji/ingest fetch:logos",
    "images:derive": "pnpm --filter @posvoji/ingest derive:images",
    "media:verify": "node scripts/verify-media.mjs"
  }
}
