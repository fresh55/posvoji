# Install as /etc/posvoji/crawl.env, root:posvoji, mode 0640.
# This is sourced by Bash; use shell quoting for values containing spaces.
POSVOJI_REPO_DIR=/srv/posvoji/app
POSVOJI_EXPECTED_SHA=REPLACE_WITH_TESTED_FULL_COMMIT_SHA
POSVOJI_HEALTH_NETRC=/etc/posvoji/health.netrc
# Set BOTH when the portal is ready; never deploy with half a configuration.
# PORTAL_EXPORT_URL=https://api.posvoji.si
# PORTAL_EXPORT_TOKEN=SET_LOCALLY
