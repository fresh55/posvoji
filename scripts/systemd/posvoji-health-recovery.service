[Unit]
Description=Email recovery of a reported Posvoji health incident
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/posvoji/alerts.env

[Service]
Type=oneshot
User=posvoji
Group=caddy
EnvironmentFile=/srv/posvoji/portal.env
EnvironmentFile=/etc/posvoji/alerts.env
ExecStart=/usr/bin/python3 /usr/local/lib/posvoji/notify-failure.py posvoji-health.service --recovered --state-directory /var/lib/posvoji-alerts
StateDirectory=posvoji-alerts
StateDirectoryMode=0700
TimeoutStartSec=90s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
