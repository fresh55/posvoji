[Unit]
Description=Verify Posvoji delivery and real source freshness
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=posvoji
Group=caddy
WorkingDirectory=/srv/posvoji/app
ExecStart=/bin/bash /srv/posvoji/app/scripts/monitor-production.sh
Environment=POSVOJI_MONITOR_NETRC_FILE=/etc/posvoji/health.netrc
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
